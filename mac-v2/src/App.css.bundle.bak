___CSS_LOADER_EXPORT___.push([module.id, `.liquid-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: var(--bg);
  transition: background-color 0.5s ease;
}
.orb {
  position: absolute;
  border-radius: 9999px;
  filter: blur(90px);
  opacity: var(--orb-opacity);
  will-change: transform;
}
.orb-a { width: 46vw; height: 46vw; left: -10vw; top: -14vw; background: #22d3ee; animation: drift 26s ease-in-out infinite; }
.orb-b { width: 40vw; height: 40vw; right: -12vw; top: 20vh; background: #8b5cf6; animation: drift 32s ease-in-out infinite reverse; }
.orb-c { width: 34vw; height: 34vw; left: 30vw; bottom: -18vw; background: #34d399; animation: drift 38s ease-in-out infinite; opacity: calc(var(--orb-opacity) * 0.6); }
@keyframes drift {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  33% { transform: translate3d(6vw, 4vh, 0) scale(1.08); }
  66% { transform: translate3d(-4vw, 8vh, 0) scale(0.94); }
}
.grain {
  position: absolute;
  inset: 0;
  opacity: var(--grain);
  mix-blend-mode: overlay;
  background-image: url(${___CSS_LOADER_URL_REPLACEMENT_0___});
}

.logo-orb {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  background: conic-gradient(from 200deg, #22d3ee, #8b5cf6, #34d399, #22d3ee);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), 0 0 24px -4px rgba(34, 211, 238, 0.6);
  animation: spin-hue 12s linear infinite;
}
@keyframes spin-hue { to { filter: hue-rotate(360deg); } }

/* ---------- Planets ---------- */
.orb-av {
  position: relative;
  flex-shrink: 0;
  isolation: isolate;
  perspective: 520px;
  animation: orb-bob calc(var(--spin) * 0.9) ease-in-out infinite;
  animation-delay: var(--delay);
}
.orb-halo {
  position: absolute;
  inset: -38%;
  border-radius: 9999px;
  background: radial-gradient(circle, color-mix(in srgb, var(--c1) 50%, transparent) 0, color-mix(in srgb, var(--c2) 16%, transparent) 42%, transparent 68%);
  filter: blur(8px);
  opacity: 0.55;
  z-index: -2;
  transition: opacity 0.5s ease, background 0.8s ease;
}
.orb-sphere {
  position: absolute;
  inset: 0;
  z-index: 0;
  border-radius: 9999px;
  overflow: hidden;
  background: radial-gradient(circle at 50% 60%, color-mix(in srgb, var(--c1) 32%, #04040c) 0, #03030a 78%);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--c1) 32%, transparent), 0 10px 28px -10px var(--c1);
}
.orb-plasma {
  position: absolute;
  inset: -12%;
  animation: orb-spin var(--spin) linear infinite;
  animation-delay: var(--delay);
  mix-blend-mode: screen;
  filter: blur(calc(var(--s) * 0.09));
}
.orb-plasma::before, .orb-plasma::after { content: ""; position: absolute; border-radius: 9999px; }
.orb-plasma.p1::before { width: 72%; height: 72%; left: 2%; top: 6%; background: var(--c1); }
.orb-plasma.p1::after { width: 46%; height: 46%; right: 4%; bottom: 8%; background: var(--c2); }
.orb-plasma.p2 { animation-duration: calc(var(--spin) * 1.7); animation-direction: reverse; opacity: 0.85; }
.orb-plasma.p2::before { width: 56%; height: 56%; right: 6%; top: 4%; background: var(--c2); }
.orb-plasma.p2::after { width: 32%; height: 32%; left: 18%; bottom: 14%; background: color-mix(in srgb, var(--c1) 50%, #fff); opacity: 0.6; }
.orb-plasma.p3 { animation-duration: calc(var(--spin) * 0.6); opacity: 0.5; }
.orb-plasma.p3::before { width: 22%; height: 22%; left: 40%; top: 22%; background: #fff; }
.orb-plasma.p3::after { width: 42%; height: 42%; left: 28%; bottom: 0; background: color-mix(in srgb, var(--c2) 60%, #fff); }
.orb-bands {
  position: absolute;
  inset: -40%;
  background: repeating-linear-gradient(
    var(--band),
    transparent 0 7%,
    color-mix(in srgb, var(--c2) 40%, transparent) 9%,
    transparent 12%,
    rgba(255, 255, 255, 0.16) 15%,
    transparent 18%,
    color-mix(in srgb, var(--c1) 30%, #000) 21%,
    transparent 24%
  );
  mix-blend-mode: overlay;
  filter: blur(calc(var(--s) * 0.025));
  animation: orb-drift calc(var(--spin) * 1.6) ease-in-out infinite alternate;
  animation-delay: var(--delay);
}
.orb-terminator {
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, transparent 36%, rgba(0, 0, 0, 0.22) 58%, rgba(0, 0, 0, 0.78) 100%);
  box-shadow:
    inset calc(var(--s) * 0.035) calc(var(--s) * 0.035) calc(var(--s) * 0.05) color-mix(in srgb, var(--c1) 55%, #fff),
    inset 0 0 calc(var(--s) * 0.12) color-mix(in srgb, var(--c1) 35%, transparent);
  animation: orb-light 9s ease-in-out infinite alternate;
  animation-delay: var(--delay);
}
.orb-flash {
  position: absolute;
  inset: 0;
  z-index: 5;
  border-radius: 9999px;
  background: radial-gradient(circle at 48% 46%, color-mix(in srgb, var(--ic) 35%, #fff) 0, var(--ic) 48%, color-mix(in srgb, var(--ic) 70%, #000) 100%);
  mix-blend-mode: hard-light;
  animation: orb-flash 0.85s ease-out forwards;
}
.orb-ripple {
  position: absolute;
  inset: 0;
  z-index: 6;
  border-radius: 9999px;
  border: 2px solid color-mix(in srgb, var(--ic) 60%, #fff);
  box-shadow: inset 0 0 10px var(--ic);
  animation: orb-ripple 0.8s ease-out forwards;
}
.orb-gloss {
  position: absolute;
  left: 17%;
  top: 11%;
  width: 34%;
  height: 22%;
  border-radius: 9999px;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0) 70%);
  transform: rotate(-28deg);
}
.orb-ring {
  position: absolute;
  inset: -30%;
  transform-style: preserve-3d;
  transform: rotate(var(--tilt)) rotateX(74deg);
  pointer-events: none;
}
.orb-ring.back { z-index: -1; }
.orb-ring.front { z-index: 1; clip-path: inset(50% 0 0 0); }
.orb-ring-track {
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  border: 1px solid color-mix(in srgb, var(--c1) 60%, transparent);
  box-shadow: 0 0 10px color-mix(in srgb, var(--c1) 45%, transparent), inset 0 0 0 calc(var(--s) * 0.05) color-mix(in srgb, var(--c2) 12%, transparent);
  animation: orb-spin calc(var(--spin) * 1.4) linear infinite;
  animation-delay: var(--delay);
}
.orb-ring-track::before {
  content: "";
  position: absolute;
  inset: 9%;
  border-radius: 9999px;
  border: 1px solid color-mix(in srgb, var(--c2) 35%, transparent);
}
.orb-moon {
  --m: max(3px, calc(var(--s) * 0.1));
  position: absolute;
  left: 50%;
  top: 0;
  width: var(--m);
  height: var(--m);
  margin: calc(var(--m) / -2) 0 0 calc(var(--m) / -2);
  border-radius: 9999px;
  background: radial-gradient(circle at 35% 35%, #fff, color-mix(in srgb, var(--c1) 60%, #fff));
  box-shadow: 0 0 6px 1px var(--c1), 0 0 12px 3px color-mix(in srgb, var(--c2) 50%, transparent);
}
.orb-moon.b { --m: max(2px, calc(var(--s) * 0.07)); top: 100%; background: var(--c2); }
.orb-impact {
  position: absolute;
  inset: 0;
  z-index: 3;
  border-radius: 9999px;
  pointer-events: none;
  box-shadow: 0 0 0 2px var(--ic), 0 0 28px 6px var(--ic);
  animation: impact 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}
.orb-av:hover .orb-halo, .glass-card:hover .orb-halo { opacity: 0.95; }
.orb-av:hover .orb-plasma, .glass-card:hover .orb-plasma { animation-duration: calc(var(--spin) / 2.5); }
.orb-live .orb-plasma { animation-duration: calc(var(--spin) / 3.5) !important; }
.orb-live .orb-ring-track { animation-duration: calc(var(--spin) / 3); }
.orb-live .orb-halo { animation: orb-breathe 2.2s ease-in-out infinite; }
.orb-live .orb-sphere { animation: orb-throb 2.2s ease-in-out infinite; }

@keyframes orb-spin { to { transform: rotate(360deg); } }
@keyframes orb-drift { from { transform: translateX(-10%) translateY(-4%); } to { transform: translateX(10%) translateY(4%); } }
@keyframes orb-breathe { 0%, 100% { transform: scale(1); opacity: 0.7; } 50% { transform: scale(1.28); opacity: 1; } }
@keyframes orb-throb { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
@keyframes impact { from { transform: scale(0.85); opacity: 1; } to { transform: scale(2.1); opacity: 0; } }
@keyframes orb-bob {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(calc(var(--s) * -0.05)) rotate(2.5deg); }
}
@keyframes orb-light { from { transform: rotate(-16deg); } to { transform: rotate(16deg); } }
@keyframes orb-flash { 0% { opacity: 0; } 14% { opacity: 1; } 100% { opacity: 0; } }
@keyframes orb-ripple { from { transform: scale(0.05); opacity: 1; } to { transform: scale(1.05); opacity: 0; } }

/* ---------- Gems ---------- */
.gem-glow { filter: drop-shadow(0 0 4px color-mix(in srgb, var(--gc) 80%, transparent)); line-height: 0; }
.gem {
  position: relative;
  display: block;
  clip-path: polygon(50% 0%, 100% 36%, 80% 100%, 20% 100%, 0% 36%);
  background: linear-gradient(160deg, color-mix(in srgb, var(--gc) 35%, #fff) 0%, var(--gc) 45%, color-mix(in srgb, var(--gc) 55%, #000) 100%);
}
.gem::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(115deg, rgba(255, 255, 255, 0.75) 0 18%, transparent 19% 58%, rgba(255, 255, 255, 0.2) 59% 70%, transparent 71%),
    linear-gradient(180deg, transparent 0 35%, rgba(0, 0, 0, 0.18) 36%);
}
.gem-flying { filter: drop-shadow(0 0 10px var(--gc)) drop-shadow(0 0 22px var(--gc)); }
.gem-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 9999px;
  padding: 2px 10px 2px 8px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: color-mix(in srgb, var(--gc) 70%, var(--fg));
  background: color-mix(in srgb, var(--gc) 14%, transparent);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gc) 35%, transparent);
}

/* ---------- Reply text ---------- */
.reply { color: var(--fg); transition: color 1.4s ease, text-shadow 1.4s ease; }
.fw { animation: fw-in 1.2s cubic-bezier(0.2, 0.6, 0.2, 1) both; }
@keyframes fw-in { from { opacity: 0; filter: blur(5px); } 60% { opacity: 0.85; } to { opacity: 1; filter: blur(0); } }

@media (prefers-reduced-motion: reduce) {
  .orb, .orb-av, .orb-plasma, .orb-bands, .orb-ring-track, .orb-halo, .orb-sphere, .orb-terminator, .logo-orb, .fw, .rise, .msg-in {
    animation: none !important;
  }
}


.dot {
  width: 6px;
  height: 6px;
  border-radius: 9999px;
  animation: bounce-dot 1s ease-in-out infinite;
}
@keyframes bounce-dot {
  0%, 100% { opacity: 0.3; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-4px); }
}

.rise { animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.msg-in { animation: rise 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
@keyframes rise {
  from { opacity: 0; transform: translateY(10px); filter: blur(4px); }
  to { opacity: 1; transform: none; filter: none; }
}

.md > * + * { margin-top: 0.7em; }
.md h1, .md h2, .md h3 { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em; }
.md h1 { font-size: 1.25rem; }
.md h2 { font-size: 1.1rem; }
.md h3 { font-size: 1rem; }
.md ul { list-style: disc; padding-left: 1.25rem; }
.md ol { list-style: decimal; padding-left: 1.25rem; }
.md li + li { margin-top: 0.25em; }
.md a { color: var(--accent); text-decoration: underline; }
.md strong { font-weight: 650; }
.md code { font-family: var(--font-mono); font-size: 0.85em; background: var(--sunk); padding: 0.1em 0.4em; border-radius: 6px; }
.md pre { background: var(--sunk); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; overflow-x: auto; }
.md pre code { background: none; padding: 0; }
.md blockquote { border-left: 2px solid var(--accent); padding-left: 0.9rem; color: var(--fg-dim); }
.md table { width: 100%; border-collapse: collapse; font-size: 0.9em; }
.md th, .md td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }

::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.55s; animation-timing-function: ease; }
.btn-ghost, .btn-solid, .btn-icon { transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1), background-color 0.2s ease, filter 0.2s ease, opacity 0.2s ease, color 0.2s ease; }
.btn-ghost:active, .btn-solid:active, .btn-icon:active { transform: scale(0.93); }
.btn-solid:hover:not(:disabled), .btn-ghost:hover { transform: translateY(-1px); }

/* ---------- Living planets v3 ---------- */
@property --gp { syntax: "<color>"; inherits: true; initial-value: transparent; }
@property --tint { syntax: "<color>"; inherits: true; initial-value: transparent; }
@property --ang { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
.orb-av { transition: --gp 0.6s ease, scale 0.45s cubic-bezier(0.3, 1.5, 0.5, 1); }
.orb-av:hover { scale: 1.08; }
.orb-plasma.p1 { transform-origin: 42% 58%; }
.orb-plasma.p2 { transform-origin: 60% 40%; }
.orb-swirl {
  position: absolute; inset: -25%;
  background: conic-gradient(from 0deg, transparent 0 12%, color-mix(in srgb, var(--c2) 70%, transparent) 22%, transparent 34%, rgba(255, 255, 255, 0.35) 48%, transparent 60%, color-mix(in srgb, var(--c1) 80%, #fff) 74%, transparent 86%);
  mix-blend-mode: soft-light; filter: blur(calc(var(--s) * 0.04));
  animation: orb-spin calc(var(--spin) * 0.8) linear infinite reverse; animation-delay: var(--delay);
}
.orb-gp {
  position: absolute; inset: 0; border-radius: 9999px; opacity: 0; transition: opacity 0.8s ease;
  background: radial-gradient(circle at 45% 42%, var(--gp), color-mix(in srgb, var(--gp) 35%, transparent) 78%);
  mix-blend-mode: color;
}
.orb-gpulse .orb-gp { animation: gp-pulse 1.6s ease-in-out infinite; }
.orb-gpulse .orb-halo {
  background: radial-gradient(circle, color-mix(in srgb, var(--gp) 75%, transparent) 0, color-mix(in srgb, var(--gp) 22%, transparent) 45%, transparent 70%);
  animation: orb-breathe 1.6s ease-in-out infinite; opacity: 1;
}
.orb-gpulse .orb-ring-track { border-color: color-mix(in srgb, var(--gp) 75%, transparent); box-shadow: 0 0 14px color-mix(in srgb, var(--gp) 60%, transparent); }
@keyframes gp-pulse { 0%, 100% { opacity: 0.12; } 50% { opacity: 0.92; } }
.orb-aurora {
  position: absolute; inset: -8%; border-radius: 9999px; z-index: 0; pointer-events: none; opacity: 0.75; mix-blend-mode: screen;
  background: conic-gradient(from 0deg, transparent, color-mix(in srgb, var(--c1) 85%, transparent), transparent 30%, color-mix(in srgb, var(--c2) 85%, transparent), transparent 62%, color-mix(in srgb, var(--gp) 80%, transparent), transparent);
  mask: radial-gradient(circle, transparent 60%, #000 67%, transparent 73%);
  filter: blur(calc(var(--s) * 0.025));
  animation: orb-spin calc(var(--spin) * 1.2) linear infinite;
}
.orb-stars {
  position: absolute; inset: -60%; z-index: -3; pointer-events: none;
  background-image: radial-gradient(1px 1px at 20% 30%, #fff, transparent), radial-gradient(1px 1px at 72% 18%, #fff, transparent), radial-gradient(1.5px 1.5px at 86% 66%, #fff, transparent), radial-gradient(1px 1px at 33% 82%, #fff, transparent), radial-gradient(1.2px 1.2px at 58% 48%, color-mix(in srgb, var(--c1) 60%, #fff), transparent), radial-gradient(1px 1px at 10% 58%, #fff, transparent), radial-gradient(1px 1px at 64% 90%, #fff, transparent); mask: radial-gradient(circle, #000 30%, transparent 70%);
  animation: twinkle 3.4s ease-in-out infinite alternate; animation-delay: var(--delay);
}
:root:not(.dark) .orb-stars { filter: invert(0.7); }
.orb-halo::after {
  content: ""; position: absolute; inset: 14%; border-radius: 9999px; filter: blur(10px);
  background: conic-gradient(from 90deg, color-mix(in srgb, var(--c2) 35%, transparent), transparent 40%, color-mix(in srgb, var(--c1) 35%, transparent), transparent 80%);
  animation: orb-spin calc(var(--spin) * 3) linear infinite;
}
.orb-comet {
  position: absolute; left: 50%; top: 0; width: calc(var(--s) * 0.45); height: 2px; margin-top: -1px; border-radius: 9999px;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c1) 60%, #fff), #fff); box-shadow: 0 0 6px #fff;
  translate: -100% 0; opacity: 0; animation: comet calc(var(--spin) * 4.2) linear infinite; animation-delay: var(--delay);
}
@keyframes comet { 0%, 68% { opacity: 0; } 74% { opacity: 1; } 88%, 100% { opacity: 0; } }
@keyframes twinkle { from { opacity: 0.25; } to { opacity: 0.9; } }
.status-live { animation: twinkle 0.8s ease-in-out infinite alternate; box-shadow: 0 0 8px currentColor; }

/* ---------- Text ---------- */
.reply.gem-pulse { color: color-mix(in srgb, var(--fg) 60%, var(--tint)); animation: text-glow 1.6s ease-in-out infinite; transition: --tint 0.6s ease, color 1s ease; }
@keyframes text-glow { 0%, 100% { text-shadow: 0 0 0 transparent; } 50% { text-shadow: 0 0 14px color-mix(in srgb, var(--tint) 60%, transparent); } }
.caret { display: inline-block; width: 8px; height: 15px; margin-left: 2px; border-radius: 3px; background: var(--cc); box-shadow: 0 0 12px var(--cc), 0 0 24px var(--cc); vertical-align: -2px; animation: caret 1s ease-in-out infinite; }
@keyframes caret { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
.skeleton { background: linear-gradient(90deg, var(--sunk) 0%, color-mix(in srgb, var(--fg) 13%, transparent) 50%, var(--sunk) 100%); background-size: 200% 100%; animation: shimmer 1.4s ease-in-out infinite; }
@keyframes shimmer { from { background-position: 150% 0; } to { background-position: -50% 0; } }

/* ---------- Background starfield ---------- */
.stars { position: absolute; inset: -5%; opacity: 0.55; transform: translate(calc(var(--mx, 0) * var(--p) * -1px), calc(var(--my, 0) * var(--p) * -1px)); transition: transform 0.8s ease-out; }
.stars-a { --p: 18; background-image: radial-gradient(1px 1px at 10px 20px, #fff, transparent), radial-gradient(1px 1px at 80px 140px, #fff, transparent), radial-gradient(1.2px 1.2px at 160px 60px, #fff, transparent), radial-gradient(1px 1px at 200px 190px, #cfe, transparent); background-size: 240px 240px; animation: star-drift 140s linear infinite; }
.stars-b { --p: 42; opacity: 0.4; background-image: radial-gradient(1.5px 1.5px at 50px 90px, #fff, transparent), radial-gradient(1px 1px at 300px 40px, #fff, transparent), radial-gradient(2px 2px at 220px 260px, #bdf, transparent); background-size: 380px 380px; animation: star-drift 220s linear infinite reverse, twinkle 5s ease-in-out infinite alternate; }
@keyframes star-drift { to { background-position: 480px 240px; } }
:root:not(.dark) .stars { opacity: 0.14; filter: invert(1); }

/* ---------- Micro-interactions ---------- */
.gem-trail { position: absolute; left: 50%; top: 50%; width: calc(10px - var(--k) * 2px); height: calc(10px - var(--k) * 2px); margin: calc((10px - var(--k) * 2px) / -2); border-radius: 9999px; background: var(--gc); box-shadow: 0 0 8px var(--gc); opacity: calc(0.75 - var(--k) * 0.18); transform: translate(calc(var(--k) * -10px), calc(var(--k) * 7px)); }
.btn-solid, .btn-ghost, .btn-icon { position: relative; overflow: hidden; }
.press-ripple { position: absolute; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 9999px; background: currentColor; opacity: 0.35; pointer-events: none; animation: press 0.6s ease-out forwards; }
@keyframes press { to { transform: scale(18); opacity: 0; } }
.gem-chip { animation: chip-pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) both; }
@keyframes chip-pop { from { transform: scale(0.6); opacity: 0; } }
.spring-in { animation: spring-in 0.45s cubic-bezier(0.3, 1.5, 0.5, 1) both; }
@keyframes spring-in { from { transform: translateY(8px) scale(0.96); opacity: 0; } }
.glass-toast { animation: toast-glow 1.4s ease-out; }
@keyframes toast-glow { from { box-shadow: 0 0 0 1px var(--accent), 0 0 30px -4px var(--accent); } to { box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.4); } }
.composer-live { position: relative; }
.composer-live::before {
  content: ""; position: absolute; inset: -1.5px; border-radius: inherit; padding: 1.5px; pointer-events: none;
  background: conic-gradient(from var(--ang), transparent 0 10%, var(--accent) 25%, transparent 40%, #a78bfa 60%, transparent 75%, #34d399 90%, transparent);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
  animation: ang 3s linear infinite;
}
@keyframes ang { to { --ang: 360deg; } }
.send-ready, .mic-on { animation: send-breathe 2.4s ease-in-out infinite; }
.mic-on { animation-duration: 1.1s; color: #f87171; }
@keyframes send-breathe { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); } 50% { box-shadow: 0 0 0 7px transparent; } }
.logo-orb { animation: spin-hue 12s linear infinite, logo-spin 18s linear infinite; }
@keyframes logo-spin { to { rotate: 360deg; } }
.confetti { position: absolute; width: 7px; height: 11px; border-radius: 2px; animation: confetti 1.25s cubic-bezier(0.15, 0.7, 0.3, 1) forwards; }
@keyframes confetti { from { transform: translate(0, 0) rotate(0) scale(0.4); opacity: 1; } to { transform: translate(var(--dx), calc(var(--dy) + 60px)) rotate(var(--r)) scale(1); opacity: 0; } }
.react-on { position: relative; overflow: visible; animation: react-pop 0.45s cubic-bezier(0.3, 1.8, 0.5, 1); }
.react-on::after { content: ""; position: absolute; inset: -4px; border-radius: 9999px; border: 2px solid var(--accent); animation: react-ring 0.5s ease-out forwards; }
@keyframes react-pop { 0% { transform: scale(0.6); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
@keyframes react-ring { from { transform: scale(0.6); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .orb-swirl, .orb-aurora, .orb-stars, .orb-comet, .orb-gp, .stars, .composer-live::before, .send-ready, .confetti, .gem-chip, .spring-in, .caret, .skeleton, .reply.gem-pulse, .orb-halo::after { animation: none !important; }
}
